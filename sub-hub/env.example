# Master token used to bootstrap the SQLite database.
# The first run imports it into the database. It can later be rotated in the UI.
MASTER_TOKEN=change-me-please

# External host port.
PORT=8787

# SQLite database path inside the container.
DB_PATH=/data/sub-hub.db

# Optional legacy fallback. Used only when the database has no enabled nodes.
NODES_FILE=/data/nodes.txt
# NODES=vless://...
#   trojan://...
